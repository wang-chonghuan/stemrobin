      "lines": [
        "3. 并集"
      ]
    },
    {
      "kind": "p",
      "label": null,
      "box": null,
      "cont": false,
      "open": true,
      "samerow": false,
      "lines": [
        "右面列有星期一和星期二"
      ]
    },
    {
      "kind": "fig",
      "label": "课程表",
      "box": [
